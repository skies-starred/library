{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A very awesome Hypixel SkyBlock library. Included by mods like Athen, JEC, and so on.",
  "authors": [
    "Starred"
  ],
  "contact": {},
  "license": "BSD 3-Clause",
  "icon": "assets/snowbird/icon.png",
  "environment": "client",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${kotlin}",
    "minecraft": "${minecraft}"
  },
  "entrypoints": {
    "client": [
      {
        "value": "foo.starred.snowbird.Snowbird",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "snowbird.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "update_checker": false,
      "badges": ["library"]
    }
  }
}